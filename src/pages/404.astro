---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import EndpointGame from '../components/EndpointGame.astro';
import { ICONS } from '../lib/site';
import { formatDate, fullTitle, getPosts, postPath } from '../lib/posts';

const latest = (await getPosts()).slice(0, 5);
---

<BaseLayout title="Page not found" description="This page doesn't exist on SIMSENblog.">
  <script is:inline slot="head">
    // Old WordPress archive URLs: send them to the matching filter or search on the blog.
    (() => {
      const path = location.pathname.toLowerCase();
      const category = path.match(/^\/category\/([^/]+)\/?/);
      const tag = path.match(/^\/tag\/([^/]+)\/?/);
      const author = /^\/author\//.test(path);
      if (category) location.replace('/?topic=' + encodeURIComponent(category[1]));
      else if (tag) location.replace('/?q=' + encodeURIComponent(tag[1].replace(/-/g, ' ')));
      else if (author) location.replace('/about/');
    })();
  </script>

  <section class="hero hero-compact">
    <EndpointGame />
  </section>

  <div class="home-layout page-layout">
    <div class="page-main">
      <header class="page-head">
        <div class="eyebrow">Error 404</div>
        <h1>This endpoint is <span>not enrolled.</span></h1>
        <p class="page-lead">
          The page you're looking for doesn't exist, or it moved when SIMSENblog left WordPress. Search the blog, or pick one of the
          latest posts below.
        </p>
      </header>

      <form class="notfound-search" action="/" method="get" role="search">
        <input type="search" name="q" id="notfoundQuery" aria-label="Search articles" placeholder="Search articles…" />
        <button class="button primary" type="submit">Search</button>
      </form>

      <section class="about-section" aria-labelledby="latest-heading">
        <h2 id="latest-heading">Latest posts</h2>
        <ul class="side-tools side-posts notfound-posts">
          {
            latest.map((p) => (
              <li>
                <a href={postPath(p)}>
                  <span class="side-tool-icon" aria-hidden="true">{ICONS[p.data.icon]}</span>
                  <span>
                    <strong>{fullTitle(p)}</strong>
                    <small>{formatDate(p.data.date)}</small>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="tool-feedback">
        <div>
          <h2>Followed a broken link?</h2>
          <p>Let me know where you found it, and I'll fix it.</p>
        </div>
        <div class="tool-feedback-links">
          <a class="button" href="/">Back to the blog →</a>
          <a class="button" href="/about/#contact">Report it →</a>
        </div>
      </section>
    </div>
    <Sidebar show="tools" />
  </div>

  <script is:inline>
    // Prefill the search with words from the missing URL, e.g. /2019/03/bitlocker-silent-encryption/ → "bitlocker silent encryption".
    (() => {
      const slug = location.pathname.split('/').filter(Boolean).pop() || '';
      if (/^[a-z][a-z0-9-]+$/i.test(slug) && slug !== '404') {
        document.getElementById('notfoundQuery').value = slug.replace(/-/g, ' ').slice(0, 60);
      }
    })();
  </script>
</BaseLayout>
