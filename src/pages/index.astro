---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';
import EndpointGame from '../components/EndpointGame.astro';
import SocialLinks from '../components/SocialLinks.astro';
import PostRow from '../components/PostRow.astro';
import { CATEGORIES, SITE } from '../lib/site';
import { getPosts } from '../lib/posts';

const posts = await getPosts();
---

<BaseLayout active="blog">
  <section class="hero hero-compact">
    <h1 class="sr-only">SIMSENblog — {SITE.tagline}</h1>
    <EndpointGame />
    <!-- Phones/tablets only: the sidebar author card moves up here. -->
    <div class="mobile-author">
      <div class="mobile-author-id">
        <img class="author-photo" src="/images/simon-portrait.png" alt={SITE.author} width="44" height="51" tabindex="0" />
        <strong>Simon <span class="nowrap">Hartmann Eriksen</span></strong>
      </div>
      <img class="mobile-author-mvp" src="/images/mvp-logo-white.png" alt="Microsoft Most Valuable Professional" width="99" height="34" />
      <SocialLinks class="mobile-socials" />
    </div>
  </section>

  <div class="home-layout">
  <section class="home-posts" id="articles">
    <h2 class="sr-only">Articles</h2>
    <div class="toolbar">
      <div class="filters" role="group" aria-label="Filter articles">
        <button class="filter" aria-pressed="true" data-category="all">All posts</button>
        {CATEGORIES.map((c) => <button class="filter" aria-pressed="false" data-category={c.toLowerCase()}>{c}</button>)}
      </div>
      <label class="search">
        <span aria-hidden="true">⌕</span>
        <input type="search" id="search" aria-label="Search articles" placeholder="Search articles…" />
      </label>
    </div>
    <div class="interactive-posts">
      {posts.map((post, i) => <PostRow post={post} index={i} />)}
    </div>
    <button class="button show-more" id="showMore" type="button" hidden>Show more posts</button>
    <section class="fulltext" id="fulltext" hidden aria-labelledby="fulltextHeading">
      <h3 class="fulltext-head" id="fulltextHeading">Found in the article text</h3>
      <ol class="fulltext-list" id="fulltextList"></ol>
    </section>
    <p class="empty" id="empty" hidden>No articles match. Try another topic or search.</p>
    <span class="result-status" id="resultStatus" role="status"></span>
  </section>
  <Sidebar show="tools" hideAuthorOnMobile />
  </div>
</BaseLayout>

<script>
  // Topic filters + search over the rendered list.
  const filters = [...document.querySelectorAll<HTMLButtonElement>('.filter')];
  const search = document.querySelector<HTMLInputElement>('#search')!;
  const cards = [...document.querySelectorAll<HTMLElement>('.expanding-post')];
  const empty = document.querySelector<HTMLElement>('#empty')!;
  const status = document.querySelector<HTMLElement>('#resultStatus')!;
  const showMore = document.querySelector<HTMLButtonElement>('#showMore')!;
  let category = 'all';

  // The list starts with the newest posts; "Show more posts" adds the next batch.
  // Searching always shows every match.
  const PAGE = 10;
  let limit = PAGE;

  // Only one preview is expanded at a time.
  function expandPost(card: HTMLElement | undefined) {
    cards.forEach((item) => {
      const open = item === card;
      item.classList.toggle('is-expanded', open);
      item.querySelector('.post-toggle')!.setAttribute('aria-expanded', String(open));
      (item.querySelector('.post-reveal') as HTMLElement).inert = !open;
    });
  }

  let hoverTimer: ReturnType<typeof setTimeout> | undefined;

  // If the expanded preview was filtered away, open the first visible one.
  function reconcilePreview() {
    clearTimeout(hoverTimer);
    const visible = cards.filter((c) => !c.hidden);
    if (!visible.some((c) => c.classList.contains('is-expanded'))) expandPost(visible[0]);
  }

  function filterPosts() {
    const query = search.value.trim().toLowerCase();
    // Every word must appear somewhere, in any order: "silent bitlocker" finds "BitLocker silent encryption".
    const words = query.split(/\s+/).filter(Boolean);
    let matched = 0, shown = 0;
    cards.forEach((card) => {
      const inCategory = category === 'all' || card.dataset.categories!.split(' ').includes(category);
      const matches = inCategory && words.every((w) => card.dataset.search!.includes(w));
      const visible = matches && (words.length > 0 || matched < limit);
      if (matches) matched++;
      card.hidden = !visible;
      if (visible) shown++;
    });
    const remaining = matched - shown;
    showMore.hidden = remaining <= 0;
    showMore.textContent = `Show more posts (${remaining} more)`;
    listMatches = matched;
    updateSummary();
    reconcilePreview();
    searchFullText(query);
  }

  // ---------- Full-text search (Pagefind) ----------
  // The list above searches titles, descriptions and tags. Pagefind (built into /pagefind/ when the site
  // is built) also searches the article text, and lists posts that only mention the words inside.
  // Not available in `npm run dev` (the index is made by `npm run build`); the list search still works.
  const fulltext = document.querySelector<HTMLElement>('#fulltext')!;
  const fulltextList = document.querySelector<HTMLOListElement>('#fulltextList')!;
  let listMatches = 0;
  let textMatches = 0;
  let pagefind: any;
  let pagefindFailed = false;
  let searchRun = 0;

  function updateSummary() {
    const query = search.value.trim();
    empty.hidden = listMatches + textMatches !== 0;
    const extra = textMatches ? `, ${textMatches} more mention it in the text` : '';
    status.textContent = query || category !== 'all' ? `${listMatches} matching article${listMatches === 1 ? '' : 's'}${extra}.` : '';
  }

  async function loadPagefind() {
    if (pagefind || pagefindFailed) return pagefind;
    try {
      const url = '/pagefind/pagefind.js';
      pagefind = await import(/* @vite-ignore */ url);
      await pagefind.options({ excerptLength: 26 });
    } catch {
      pagefindFailed = true;
    }
    return pagefind;
  }

  const cardFor = (url: string) =>
    cards.find((c) => c.querySelector<HTMLAnchorElement>('a.post-title')!.getAttribute('href') === url);

  async function searchFullText(query: string) {
    const run = ++searchRun;
    if (query.length < 2) return showTextResults([]);
    const pf = await loadPagefind();
    if (!pf || run !== searchRun) return;
    const found = await pf.search(query);
    if (run !== searchRun) return;
    // Only posts in the current topic that the list above doesn't already show.
    const extra = [];
    for (const r of found.results.slice(0, 30)) {
      const data = await r.data();
      if (run !== searchRun) return;
      const card = cardFor(data.url);
      if (!card || !card.hidden) continue;
      if (category !== 'all' && !card.dataset.categories!.split(' ').includes(category)) continue;
      extra.push({ card, data });
      if (extra.length === 8) break;
    }
    showTextResults(extra);
  }

  function showTextResults(results: { card: HTMLElement; data: any }[]) {
    textMatches = results.length;
    fulltextList.replaceChildren(
      ...results.map(({ card, data }) => {
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.className = 'fulltext-title';
        a.href = data.url;
        a.textContent = card.querySelector('a.post-title')!.textContent;
        const meta = document.createElement('span');
        meta.className = 'fulltext-meta';
        meta.textContent = [...card.querySelector('.meta')!.children].map((el) => el.textContent!.trim()).filter(Boolean).join(' · ');
        const excerpt = document.createElement('p');
        excerpt.className = 'fulltext-excerpt';
        // Pagefind escapes the page text and wraps the matching words in <mark>.
        excerpt.innerHTML = `…${data.excerpt}…`;
        li.append(a, meta, excerpt);
        return li;
      }),
    );
    fulltext.hidden = results.length === 0;
    updateSummary();
  }

  // Start loading the index as soon as someone heads for the search box.
  search.addEventListener('focus', () => loadPagefind(), { once: true });

  filters.forEach((button) =>
    button.addEventListener('click', () => {
      category = button.dataset.category!;
      limit = PAGE;
      filters.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
      filterPosts();
    }),
  );
  search.addEventListener('input', () => {
    limit = PAGE;
    filterPosts();
  });

  showMore.addEventListener('click', () => {
    const before = cards.filter((c) => !c.hidden).length;
    limit += PAGE;
    filterPosts();
    // Keyboard users continue from the first newly shown post.
    cards.filter((c) => !c.hidden)[before]?.querySelector<HTMLElement>('a.post-title')?.focus({ preventScroll: true });
  });

  cards.forEach((card) => {
    // Mouse hover expands after a short 40 ms delay; touch and keyboard use tap / focus.
    card.addEventListener('pointerenter', (event) => {
      if (event.pointerType !== 'mouse') return;
      clearTimeout(hoverTimer);
      hoverTimer = setTimeout(() => expandPost(card), 40);
    });
    card.addEventListener('pointerleave', () => clearTimeout(hoverTimer));
    // The headline is a link to the article; the rest of the row (and the + button) opens the preview.
    card.querySelector('.post-row')!.addEventListener('click', (event) => {
      if ((event.target as Element).closest('a')) return;
      expandPost(card);
    });
    card.addEventListener('focusin', () => {
      clearTimeout(hoverTimer);
      expandPost(card);
    });
  });

  // Links like /?topic=intune or /?q=bitlocker (used by the 404 page for old WordPress category and tag URLs).
  const params = new URLSearchParams(location.search);
  const topic = params.get('topic')?.toLowerCase();
  const preset = filters.find((f) => f.dataset.category === topic);
  if (params.get('q')) search.value = params.get('q')!;
  if (preset) preset.click();
  else filterPosts();
</script>
