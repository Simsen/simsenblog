---
/**
 * Endpoint Defense: a tiny canvas game in the homepage header.
 * Threats drift toward the endpoints; click / tap (or Space) to fire lasers.
 * Runs a self-playing demo until someone interacts. Pauses when off-screen.
 */
---

<div class="game">
  <div class="game-hud" aria-hidden="true">
    <span class="game-title">ENDPOINT DEFENSE</span>
    <span class="game-hint" id="gameHint">Demo · click to play</span>
    <span class="game-score" id="gameScore"></span>
  </div>
  <canvas
    id="endpointGame"
    tabindex="0"
    role="application"
    aria-label="Endpoint Defense mini game. Click or tap to fire lasers at incoming threats, or press Space to fire at the closest one."
  ></canvas>
  <span class="sr-only" id="gameStatus" role="status"></span>
</div>

<script>
  type Kind = 'laptop' | 'desktop' | 'phone' | 'tablet';
  interface Endpoint { x: number; y: number; kind: Kind; hit: number; flash: number }
  interface Threat { x: number; y: number; vx: number; vy: number; target: number; spin: number; marked: boolean }
  interface Beam { x1: number; y1: number; x2: number; y2: number; life: number }
  interface Spark { x: number; y: number; vx: number; vy: number; life: number; color: string }

  const COLORS = {
    panel: '#141929',
    grid: 'rgba(84,127,255,0.07)',
    line: '#252b3b',
    device: '#9ab4ff',
    deviceDim: '#34456c',
    ok: '#5bd68f',
    bad: '#ff6b7a',
    threat: '#ff6b7a',
    laser: '#547fff',
    laserCore: '#dbe5ff',
  };

  const canvas = document.querySelector<HTMLCanvasElement>('#endpointGame')!;
  const ctx = canvas.getContext('2d')!;
  const hint = document.querySelector<HTMLElement>('#gameHint')!;
  const scoreEl = document.querySelector<HTMLElement>('#gameScore')!;
  const status = document.querySelector<HTMLElement>('#gameStatus')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(pointer: coarse)').matches;

  let W = 0, H = 0;
  let endpoints: Endpoint[] = [];
  let threats: Threat[] = [];
  let beams: Beam[] = [];
  let sparks: Spark[] = [];
  let mode: 'demo' | 'play' = 'demo';
  let blocked = 0, breached = 0;
  let spawnIn = 0.6, playTime = 0, lastInput = 0, clock = 0;
  let visible = true, running = false, last = 0;

  const groundY = () => H - 16;

  function layout() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = rect.width; H = rect.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    const kinds: Kind[] = ['laptop', 'phone', 'desktop', 'tablet', 'laptop', 'phone', 'desktop'];
    const n = W < 480 ? 4 : W < 720 ? 5 : 7;
    const old = endpoints;
    endpoints = Array.from({ length: n }, (_, i) => ({
      x: (W * (i + 0.5)) / n,
      y: groundY(),
      kind: kinds[i % kinds.length],
      hit: old[i]?.hit ?? 0,
      flash: 0,
    }));
    threats.forEach((t) => (t.target = Math.min(t.target, n - 1)));
    if (!running) draw();
  }

  function spawn() {
    const target = Math.floor(Math.random() * endpoints.length);
    const e = endpoints[target];
    const x = Math.random() * W;
    const y = 22;
    const level = mode === 'play' ? Math.min(playTime / 30, 2.5) : 0;
    const speed = (H < 140 ? 22 : 28) + level * 12 + Math.random() * 8;
    const dx = e.x - x, dy = e.y - 14 - y;
    const d = Math.hypot(dx, dy);
    threats.push({ x, y, vx: (dx / d) * speed, vy: (dy / d) * speed, target, spin: Math.random() * 6, marked: false });
  }

  function burst(x: number, y: number, color: string, count = 12) {
    for (let i = 0; i < count; i++) {
      const a = Math.random() * Math.PI * 2, s = 30 + Math.random() * 90;
      sparks.push({ x, y, vx: Math.cos(a) * s, vy: Math.sin(a) * s, life: 0.35 + Math.random() * 0.3, color });
    }
  }

  function nearestEndpoint(x: number) {
    let best = endpoints[0], bd = Infinity;
    for (const e of endpoints) {
      const d = Math.abs(e.x - x);
      if (d < bd) { bd = d; best = e; }
    }
    return best;
  }

  function fire(x: number, y: number) {
    const e = nearestEndpoint(x);
    e.flash = 0.15;
    beams.push({ x1: e.x, y1: e.y - 22, x2: x, y2: y, life: 0.2 });
    const radius = touch ? 30 : 22;
    let hits = 0;
    threats = threats.filter((t) => {
      if (Math.hypot(t.x - x, t.y - y) < radius) {
        burst(t.x, t.y, COLORS.laser);
        hits++;
        return false;
      }
      return true;
    });
    if (mode === 'play') blocked += hits;
    return hits;
  }

  function startPlay() {
    if (mode !== 'play') {
      mode = 'play';
      blocked = 0; breached = 0; playTime = 0;
      threats = [];
      spawnIn = 0.3;
    }
    lastInput = clock;
    if (!running) start();
  }

  function update(dt: number) {
    clock += dt;
    if (mode === 'play') {
      playTime += dt;
      if (clock - lastInput > 20) {
        mode = 'demo';
        if (reducedMotion) running = false;
        status.textContent = `Game over. ${blocked} threats blocked, ${breached} breached.`;
      }
    }

    spawnIn -= dt;
    if (spawnIn <= 0) {
      spawn();
      const base = mode === 'play' ? Math.max(0.45, 1.3 - playTime * 0.012) : 0.8;
      spawnIn = base * (0.7 + Math.random() * 0.6);
    }

    for (const t of threats) {
      t.x += t.vx * dt; t.y += t.vy * dt; t.spin += dt * 3;
      // Demo: endpoints defend themselves now and then.
      if (mode === 'demo' && !t.marked && t.y > H * 0.35 && Math.random() < dt * 1.6) {
        t.marked = true;
        const tx = t.x + t.vx * 0.05, ty = t.y + t.vy * 0.05;
        setTimeout(() => fire(tx, ty), 40);
      }
    }

    threats = threats.filter((t) => {
      const e = endpoints[t.target];
      if (!e) return false;
      if (t.y >= e.y - 16) {
        e.hit = 2.2;
        burst(t.x, t.y, COLORS.bad, 10);
        if (mode === 'play') breached++;
        return false;
      }
      return true;
    });

    for (const e of endpoints) { e.hit = Math.max(0, e.hit - dt); e.flash = Math.max(0, e.flash - dt); }
    for (const b of beams) b.life -= dt;
    beams = beams.filter((b) => b.life > 0);
    for (const s of sparks) { s.x += s.vx * dt; s.y += s.vy * dt; s.vx *= 0.94; s.vy *= 0.94; s.life -= dt; }
    sparks = sparks.filter((s) => s.life > 0);

    hint.textContent = mode === 'play' ? (touch ? 'Tap to fire' : 'Click to fire · Space') : touch ? 'Demo · tap to play' : 'Demo · click to play';
    scoreEl.textContent = mode === 'play' ? `Blocked ${blocked} · Breached ${breached}` : '';
  }

  function drawDevice(e: Endpoint) {
    const bad = e.hit > 0;
    const c = bad ? COLORS.bad : COLORS.device;
    ctx.save();
    ctx.translate(e.x, e.y);
    ctx.strokeStyle = c;
    ctx.fillStyle = bad ? 'rgba(255,107,122,0.12)' : e.flash > 0 ? 'rgba(84,127,255,0.35)' : 'rgba(84,127,255,0.10)';
    ctx.lineWidth = 1.5;
    ctx.lineJoin = 'round';
    const r = (x: number, y: number, w: number, h: number, rad = 2) => {
      ctx.beginPath(); ctx.roundRect(x, y, w, h, rad); ctx.fill(); ctx.stroke();
    };
    switch (e.kind) {
      case 'laptop':
        r(-13, -20, 26, 16);
        ctx.beginPath(); ctx.moveTo(-17, -1); ctx.lineTo(17, -1); ctx.stroke();
        break;
      case 'desktop':
        r(-14, -24, 28, 18);
        ctx.beginPath(); ctx.moveTo(0, -6); ctx.lineTo(0, -1); ctx.moveTo(-6, -1); ctx.lineTo(6, -1); ctx.stroke();
        break;
      case 'phone':
        r(-6, -22, 12, 21, 3);
        ctx.beginPath(); ctx.moveTo(-2, -4); ctx.lineTo(2, -4); ctx.stroke();
        break;
      case 'tablet':
        r(-10, -22, 20, 21, 3);
        break;
    }
    // Compliance light
    ctx.beginPath();
    ctx.arc(0, -30, 2.5, 0, Math.PI * 2);
    ctx.fillStyle = bad ? COLORS.bad : COLORS.ok;
    ctx.shadowColor = ctx.fillStyle;
    ctx.shadowBlur = 6;
    ctx.fill();
    ctx.restore();
  }

  function drawThreat(t: Threat) {
    ctx.save();
    ctx.translate(t.x, t.y);
    ctx.rotate(t.spin);
    ctx.fillStyle = 'rgba(255,107,122,0.18)';
    ctx.strokeStyle = COLORS.threat;
    ctx.lineWidth = 1.5;
    ctx.shadowColor = COLORS.threat;
    ctx.shadowBlur = 8;
    ctx.beginPath();
    ctx.moveTo(0, -6); ctx.lineTo(6, 0); ctx.lineTo(0, 6); ctx.lineTo(-6, 0); ctx.closePath();
    ctx.fill(); ctx.stroke();
    ctx.restore();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    // Dot grid
    ctx.fillStyle = COLORS.grid;
    for (let x = 12; x < W; x += 24) for (let y = 12; y < groundY() - 30; y += 24) ctx.fillRect(x, y, 1.5, 1.5);
    // Ground
    ctx.strokeStyle = COLORS.line;
    ctx.lineWidth = 1;
    ctx.beginPath(); ctx.moveTo(0, groundY() + 0.5); ctx.lineTo(W, groundY() + 0.5); ctx.stroke();

    for (const t of threats) drawThreat(t);

    for (const b of beams) {
      const a = Math.max(0, b.life / 0.2);
      ctx.save();
      ctx.globalAlpha = a;
      ctx.strokeStyle = COLORS.laser;
      ctx.shadowColor = COLORS.laser;
      ctx.shadowBlur = 12;
      ctx.lineWidth = 3;
      ctx.beginPath(); ctx.moveTo(b.x1, b.y1); ctx.lineTo(b.x2, b.y2); ctx.stroke();
      ctx.strokeStyle = COLORS.laserCore;
      ctx.shadowBlur = 0;
      ctx.lineWidth = 1;
      ctx.stroke();
      ctx.restore();
    }

    for (const s of sparks) {
      ctx.globalAlpha = Math.min(1, s.life * 2.5);
      ctx.fillStyle = s.color;
      ctx.fillRect(s.x - 1, s.y - 1, 2, 2);
    }
    ctx.globalAlpha = 1;

    for (const e of endpoints) drawDevice(e);
  }

  function frame(now: number) {
    if (!running) return;
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    update(dt);
    draw();
    requestAnimationFrame(frame);
  }

  function start() {
    if (running) return;
    if (reducedMotion && mode === 'demo') { draw(); return; }
    running = true;
    last = performance.now();
    requestAnimationFrame(frame);
  }
  function stop() { running = false; }
  function sync() { (visible && !document.hidden ? start : stop)(); }

  // Input
  canvas.addEventListener('pointerdown', (ev) => {
    const rect = canvas.getBoundingClientRect();
    startPlay();
    fire(ev.clientX - rect.left, ev.clientY - rect.top);
  });
  canvas.addEventListener('keydown', (ev) => {
    if (ev.key !== ' ' && ev.key !== 'Enter') return;
    ev.preventDefault();
    startPlay();
    const target = threats.reduce<Threat | undefined>((a, t) => (!a || t.y > a.y ? t : a), undefined);
    if (target) fire(target.x, target.y);
  });

  new ResizeObserver(layout).observe(canvas);
  new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(canvas);
  document.addEventListener('visibilitychange', sync);

  layout();
  sync();
</script>
