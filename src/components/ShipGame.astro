---
/**
 * Zero Trust Patrol: a small side-scrolling shooter for the About page header.
 * The ship flies left to right through a starfield; threats come in from the right.
 * Mouse / touch: the ship follows your pointer, press to fire. Keyboard: ↑ ↓ (or W S) and Space.
 * Self-playing demo until someone interacts. Pauses when off-screen.
 */
---

<div class="game">
  <div class="game-hud" aria-hidden="true">
    <span class="game-title">ZERO TRUST PATROL</span>
    <span class="game-hint" id="shipHint">Demo · click to play</span>
    <span class="game-score" id="shipScore"></span>
  </div>
  <canvas
    id="shipGame"
    class="no-touch-scroll"
    tabindex="0"
    role="application"
    aria-label="Zero Trust Patrol mini game. Fly the ship and shoot incoming threats. Move with the mouse or the up and down arrow keys, fire by clicking or with Space. Touch: drag to move, the ship fires while you hold."
  ></canvas>
  <span class="sr-only" id="shipStatus" role="status"></span>
</div>

<script>
  interface Star { x: number; y: number; z: number }
  interface Shot { x: number; y: number; vy: number }
  interface Foe { x: number; y: number; vx: number; vy: number; r: number; hp: number; kind: 'threat' | 'rock' | 'patch'; spin: number; hit: number; pts: number[] }
  interface Spark { x: number; y: number; vx: number; vy: number; life: number; color: string }

  const C = {
    star: '#9ab4ff',
    ship: '#9ab4ff',
    shipFill: 'rgba(84,127,255,0.25)',
    flame: '#547fff',
    shot: '#dbe5ff',
    threat: '#ff6b7a',
    rock: '#7d88a3',
    patch: '#5bd68f',
    shield: '#547fff',
  };

  const canvas = document.querySelector<HTMLCanvasElement>('#shipGame')!;
  const ctx = canvas.getContext('2d')!;
  const hint = document.querySelector<HTMLElement>('#shipHint')!;
  const scoreEl = document.querySelector<HTMLElement>('#shipScore')!;
  const status = document.querySelector<HTMLElement>('#shipStatus')!;
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const touch = matchMedia('(pointer: coarse)').matches;

  const TOP = 28;
  let W = 0, H = 0;
  let stars: Star[] = [], shots: Shot[] = [], foes: Foe[] = [], sparks: Spark[] = [];
  const ship = { x: 60, y: 90, ty: 90, shields: 3, inv: 0, cool: 0, twin: 0 };
  let mode: 'demo' | 'play' | 'over' = 'demo';
  let score = 0, best = 0, spawnIn = 0.8, playTime = 0, lastInput = 0, clock = 0;
  let firing = false, keyUp = false, keyDown = false;
  let visible = true, running = false, last = 0;

  try { best = Number(localStorage.getItem('ztPatrolBest')) || 0; } catch {}

  const minY = () => TOP + 10;
  const maxY = () => H - 12;

  function layout() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(devicePixelRatio || 1, 2);
    const firstRun = W === 0;
    W = rect.width; H = rect.height;
    canvas.width = Math.round(W * dpr);
    canvas.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ship.x = Math.max(40, Math.min(80, W * 0.08));
    if (firstRun) { ship.y = ship.ty = (minY() + maxY()) / 2; }
    stars = Array.from({ length: Math.round(W / 9) }, () => ({ x: Math.random() * W, y: minY() - 8 + Math.random() * (H - minY() + 8), z: 0.25 + Math.random() * 0.75 }));
    draw();
  }

  function reset(next: 'demo' | 'play') {
    mode = next;
    foes = []; shots = [];
    score = 0; playTime = 0; spawnIn = 0.6;
    ship.shields = 3; ship.inv = 0; ship.twin = 0;
  }

  function spawn() {
    const level = mode === 'play' ? Math.min(playTime / 25, 3) : 0.6;
    const roll = Math.random();
    const kind: Foe['kind'] = roll < 0.07 ? 'patch' : roll < 0.4 ? 'rock' : 'threat';
    const r = kind === 'rock' ? 9 + Math.random() * 5 : kind === 'patch' ? 7 : 7;
    const y = minY() + r + Math.random() * (maxY() - minY() - r * 2);
    const speed = (kind === 'rock' ? 70 : 95) + level * 28 + Math.random() * 25;
    const pts = Array.from({ length: 8 }, () => 0.75 + Math.random() * 0.35);
    foes.push({ x: W + r + 4, y, vx: -speed, vy: kind === 'threat' ? (Math.random() - 0.5) * 30 : 0, r, hp: kind === 'rock' ? 2 : 1, kind, spin: Math.random() * 6, hit: 0, pts });
  }

  function burst(x: number, y: number, color: string, n = 12) {
    for (let i = 0; i < n; i++) {
      const a = Math.random() * Math.PI * 2, s = 30 + Math.random() * 110;
      sparks.push({ x, y, vx: Math.cos(a) * s - 40, vy: Math.sin(a) * s, life: 0.3 + Math.random() * 0.35, color });
    }
  }

  function fire() {
    if (ship.cool > 0) return;
    ship.cool = ship.twin > 0 ? 0.14 : 0.2;
    const nose = ship.x + 14;
    if (ship.twin > 0) {
      shots.push({ x: nose, y: ship.y - 4, vy: -20 }, { x: nose, y: ship.y + 4, vy: 20 });
    } else {
      shots.push({ x: nose, y: ship.y, vy: 0 });
    }
  }

  function gameOver() {
    mode = 'over';
    burst(ship.x, ship.y, C.ship, 26);
    if (score > best) { best = score; try { localStorage.setItem('ztPatrolBest', String(best)); } catch {} }
    status.textContent = `Shields down. ${score} threats neutralised. Best ${best}.`;
  }

  function update(dt: number) {
    clock += dt;
    if (mode === 'play') {
      playTime += dt;
      if (clock - lastInput > 20) reset('demo');
    } else if (mode === 'over' && clock - lastInput > 12) {
      reset('demo');
    }

    // Stars scroll left: we're flying right.
    for (const s of stars) {
      s.x -= (40 + s.z * 160) * dt;
      if (s.x < 0) { s.x += W; s.y = minY() - 8 + Math.random() * (H - minY() + 8); }
    }

    if (mode !== 'over') {
      // Steering
      if (mode === 'demo') {
        const target = foes.filter((f) => f.kind !== 'rock' || f.x < W * 0.8).sort((a, b) => a.x - b.x)[0];
        const danger = foes.find((f) => f.x - ship.x < 70 && f.x > ship.x && Math.abs(f.y - ship.y) < f.r + 12 && f.kind !== 'patch');
        if (danger) ship.ty = danger.y > (minY() + maxY()) / 2 ? danger.y - 40 : danger.y + 40;
        else if (target) ship.ty = target.y;
        if (target && Math.abs(target.y - ship.y) < 10 && target.kind !== 'patch') fire();
      } else {
        if (keyUp) ship.ty -= 190 * dt;
        if (keyDown) ship.ty += 190 * dt;
        if (firing) fire();
      }
      ship.ty = Math.max(minY(), Math.min(maxY(), ship.ty));
      ship.y += (ship.ty - ship.y) * Math.min(1, dt * 10);
      ship.cool = Math.max(0, ship.cool - dt);
      ship.inv = Math.max(0, ship.inv - dt);
      ship.twin = Math.max(0, ship.twin - dt);

      spawnIn -= dt;
      if (spawnIn <= 0) {
        spawn();
        const base = mode === 'play' ? Math.max(0.35, 1.0 - playTime * 0.012) : 0.75;
        spawnIn = base * (0.6 + Math.random() * 0.8);
      }
    }

    for (const s of shots) { s.x += 520 * dt; s.y += s.vy * dt; }
    shots = shots.filter((s) => s.x < W + 10);

    for (const f of foes) {
      f.x += f.vx * dt; f.y += f.vy * dt; f.spin += dt * (f.kind === 'rock' ? 1 : 3); f.hit = Math.max(0, f.hit - dt);
      if (f.y < minY() + f.r || f.y > maxY() - f.r) f.vy *= -1;
    }

    // Shots vs foes
    for (const s of shots) {
      for (const f of foes) {
        if (f.hp > 0 && f.kind !== 'patch' && Math.hypot(s.x - f.x, s.y - f.y) < f.r + 3) {
          s.x = W + 100;
          f.hp--; f.hit = 0.12;
          if (f.hp <= 0) {
            burst(f.x, f.y, f.kind === 'rock' ? C.rock : C.threat, f.kind === 'rock' ? 16 : 12);
            if (mode === 'play') score += f.kind === 'rock' ? 2 : 1;
          }
          break;
        }
      }
    }

    // Foes vs ship
    if (mode !== 'over') {
      for (const f of foes) {
        if (f.hp <= 0) continue;
        if (Math.hypot(f.x - ship.x, f.y - ship.y) < f.r + 9) {
          if (f.kind === 'patch') {
            f.hp = 0; ship.twin = 6; burst(f.x, f.y, C.patch, 14);
            if (mode === 'play') score += 1;
          } else if (ship.inv <= 0) {
            f.hp = 0; burst(f.x, f.y, C.threat, 14);
            if (mode === 'play') {
              ship.shields--; ship.inv = 1.4;
              if (ship.shields <= 0) gameOver();
            } else {
              ship.inv = 1.4;
            }
          }
        }
      }
    }
    foes = foes.filter((f) => f.hp > 0 && f.x > -f.r - 10);

    for (const s of sparks) { s.x += s.vx * dt; s.y += s.vy * dt; s.vx *= 0.94; s.vy *= 0.94; s.life -= dt; }
    sparks = sparks.filter((s) => s.life > 0);

    if (mode === 'demo') hint.textContent = touch ? 'Demo · tap to play' : 'Demo · click to play';
    else if (mode === 'play') hint.textContent = touch ? 'Drag to fly · hold to fire' : 'Mouse or ↑ ↓ · click or Space to fire';
    else hint.textContent = touch ? 'Shields down · tap to retry' : 'Shields down · click or press Space';
    scoreEl.textContent =
      mode === 'demo' ? (best ? `Best ${best}` : '') : `Neutralised ${score} · Shields ${'●'.repeat(Math.max(0, ship.shields))}${'○'.repeat(3 - Math.max(0, ship.shields))} · Best ${Math.max(best, score)}`;
  }

  function drawShip() {
    if (mode === 'over') return;
    if (ship.inv > 0 && Math.floor(ship.inv * 12) % 2 === 0) return; // blink while invulnerable
    ctx.save();
    ctx.translate(ship.x, ship.y);
    // Engine flame
    const f = 6 + Math.random() * 5;
    ctx.fillStyle = C.flame;
    ctx.shadowColor = C.flame; ctx.shadowBlur = 10;
    ctx.beginPath(); ctx.moveTo(-10, -3); ctx.lineTo(-10 - f, 0); ctx.lineTo(-10, 3); ctx.closePath(); ctx.fill();
    // Hull
    ctx.shadowColor = C.ship; ctx.shadowBlur = 8;
    ctx.fillStyle = C.shipFill; ctx.strokeStyle = C.ship; ctx.lineWidth = 1.6; ctx.lineJoin = 'round';
    ctx.beginPath();
    ctx.moveTo(14, 0); ctx.lineTo(-6, -8); ctx.lineTo(-10, -8); ctx.lineTo(-7, 0); ctx.lineTo(-10, 8); ctx.lineTo(-6, 8);
    ctx.closePath(); ctx.fill(); ctx.stroke();
    // Cockpit
    ctx.shadowBlur = 0;
    ctx.fillStyle = C.ship;
    ctx.beginPath(); ctx.ellipse(3, 0, 3, 1.8, 0, 0, Math.PI * 2); ctx.fill();
    // Twin-shot shield ring
    if (ship.twin > 0) {
      ctx.strokeStyle = 'rgba(91,214,143,0.6)'; ctx.lineWidth = 1;
      ctx.beginPath(); ctx.arc(0, 0, 15, 0, Math.PI * 2); ctx.stroke();
    }
    ctx.restore();
  }

  function drawFoe(f: Foe) {
    ctx.save();
    ctx.translate(f.x, f.y);
    ctx.rotate(f.spin);
    ctx.lineWidth = 1.5;
    if (f.kind === 'rock') {
      ctx.strokeStyle = f.hit > 0 ? '#ffffff' : C.rock;
      ctx.fillStyle = 'rgba(125,136,163,0.15)';
      ctx.beginPath();
      f.pts.forEach((p, i) => {
        const a = (i / f.pts.length) * Math.PI * 2;
        const x = Math.cos(a) * f.r * p, y = Math.sin(a) * f.r * p;
        i ? ctx.lineTo(x, y) : ctx.moveTo(x, y);
      });
      ctx.closePath(); ctx.fill(); ctx.stroke();
    } else if (f.kind === 'patch') {
      ctx.rotate(-f.spin);
      ctx.strokeStyle = C.patch; ctx.fillStyle = 'rgba(91,214,143,0.18)';
      ctx.shadowColor = C.patch; ctx.shadowBlur = 10;
      ctx.beginPath(); ctx.roundRect(-7, -7, 14, 14, 3); ctx.fill(); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(-3.5, 0); ctx.lineTo(3.5, 0); ctx.moveTo(0, -3.5); ctx.lineTo(0, 3.5); ctx.stroke();
    } else {
      ctx.strokeStyle = f.hit > 0 ? '#ffffff' : C.threat;
      ctx.fillStyle = 'rgba(255,107,122,0.18)';
      ctx.shadowColor = C.threat; ctx.shadowBlur = 8;
      ctx.beginPath(); ctx.moveTo(0, -f.r); ctx.lineTo(f.r, 0); ctx.lineTo(0, f.r); ctx.lineTo(-f.r, 0); ctx.closePath();
      ctx.fill(); ctx.stroke();
    }
    ctx.restore();
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    for (const s of stars) {
      ctx.globalAlpha = 0.15 + s.z * 0.5;
      ctx.fillStyle = C.star;
      const len = 1 + s.z * 3;
      ctx.fillRect(s.x, s.y, len, s.z > 0.7 ? 1.5 : 1);
    }
    ctx.globalAlpha = 1;

    for (const f of foes) drawFoe(f);

    ctx.save();
    ctx.strokeStyle = C.shot; ctx.shadowColor = C.flame; ctx.shadowBlur = 8; ctx.lineWidth = 2; ctx.lineCap = 'round';
    for (const s of shots) { ctx.beginPath(); ctx.moveTo(s.x - 8, s.y); ctx.lineTo(s.x, s.y); ctx.stroke(); }
    ctx.restore();

    drawShip();

    for (const s of sparks) {
      ctx.globalAlpha = Math.min(1, s.life * 2.5);
      ctx.fillStyle = s.color;
      ctx.fillRect(s.x - 1, s.y - 1, 2, 2);
    }
    ctx.globalAlpha = 1;
  }

  function frame(now: number) {
    if (!running) return;
    const dt = Math.min((now - last) / 1000, 0.05);
    last = now;
    update(dt);
    draw();
    requestAnimationFrame(frame);
  }
  function start() {
    if (running) return;
    if (reducedMotion && mode === 'demo') { draw(); return; }
    running = true;
    last = performance.now();
    requestAnimationFrame(frame);
  }
  function stop() { running = false; }
  function sync() { (visible && !document.hidden ? start : stop)(); }

  function begin() {
    lastInput = clock;
    if (mode !== 'play') reset('play');
    start();
  }

  // Pointer: the ship follows the pointer's height; pressing fires (and starts a game).
  const pointerY = (ev: PointerEvent) => ev.clientY - canvas.getBoundingClientRect().top;
  canvas.addEventListener('pointerdown', (ev) => {
    canvas.focus({ preventScroll: true });
    begin();
    ship.ty = pointerY(ev);
    firing = true;
    fire();
  });
  canvas.addEventListener('pointermove', (ev) => {
    if (mode !== 'play') return;
    if (ev.pointerType === 'mouse' || firing) { ship.ty = pointerY(ev); lastInput = clock; }
  });
  addEventListener('pointerup', () => (firing = false));
  canvas.addEventListener('pointerleave', (ev) => { if (ev.pointerType === 'mouse') firing = false; });

  // Keyboard, only while the game has focus.
  canvas.addEventListener('keydown', (ev) => {
    const k = ev.code;
    if (k === 'ArrowUp' || k === 'KeyW') { ev.preventDefault(); if (mode !== 'play') begin(); keyUp = true; lastInput = clock; }
    else if (k === 'ArrowDown' || k === 'KeyS') { ev.preventDefault(); if (mode !== 'play') begin(); keyDown = true; lastInput = clock; }
    else if (k === 'Space' || k === 'Enter') { ev.preventDefault(); if (mode !== 'play') begin(); firing = true; lastInput = clock; }
  });
  canvas.addEventListener('keyup', (ev) => {
    const k = ev.code;
    if (k === 'ArrowUp' || k === 'KeyW') keyUp = false;
    else if (k === 'ArrowDown' || k === 'KeyS') keyDown = false;
    else if (k === 'Space' || k === 'Enter') firing = false;
  });
  canvas.addEventListener('blur', () => { keyUp = keyDown = firing = false; });

  new ResizeObserver(layout).observe(canvas);
  new IntersectionObserver(([entry]) => { visible = entry.isIntersecting; sync(); }).observe(canvas);
  document.addEventListener('visibilitychange', sync);

  layout();
  sync();
</script>
