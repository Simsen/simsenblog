---

<nav class:list={['socials', className]} aria-label={label}>
  {
    SOCIALS.map((s) => (
      <a href={s.url} aria-label={s.label} title={s.label} rel="me noopener">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true">
          <path d={ICONS[s.id]} />
        </svg>
      </a>
    ))
  }
</nav>
