---
import { SOCIALS } from '../lib/site';

interface Props {
  class?: string;
  /** Screen-reader name; must differ when the links appear twice on one page. */
  label?: string;
}
const { class: className, label = 'Find me elsewhere' } = Astro.props;

// Brand marks, 24×24 viewBox, drawn with currentColor.
