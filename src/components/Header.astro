---
import { SITE } from '../lib/site';

interface Props {
  active?: 'blog' | 'tools' | 'courses' | 'links' | 'about';
}
const { active } = Astro.props;

const links = [
  { id: 'blog', label: 'Blog', href: '/' },
  { id: 'tools', label: 'Tools', href: '/tools/' },
  { id: 'courses', label: 'Courses', href: '/course/' },
  { id: 'links', label: 'Links', href: '/links/' },
  { id: 'about', label: 'About', href: '/about/' },
] as const;
---

<header class="nav">
  <a class="brand" href="/" aria-label="simsenblog.dk home">
    <img src="/images/logo-white.png" alt="SIMSENblog.dk" width="230" height="62" />
  </a>
  <nav aria-label="Main navigation">
    {links.map((l) => <a class={active === l.id ? 'active' : undefined} href={l.href} aria-current={active === l.id ? 'page' : undefined}>{l.label}</a>)}
  </nav>
  <a class="github" href={SITE.github}>
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.95 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.6 9.6 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.85-2.34 4.69-4.57 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2z"></path></svg>GitHub
  </a>
</header>
